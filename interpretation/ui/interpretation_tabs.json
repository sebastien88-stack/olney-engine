  "rendering_rules": {
    "hide_empty_sections": true,
    "show_two_polarities_when_unknown": true,
    "highlight_known_polarity_without_hiding_other": true,
    "show_crown_before_planet_context": true,
    "show_active_card_before_owner_card": true
  },
  "full_cycle_tab": {
    "label": "Lecture du cycle",
    "cycles": [
      "life_path",
      "seven_year",
      "annual",
      "week"
    ],
    "scroll_scope": "whole_cycle_view_including_seven_card_strip",
    "status_reference": "real_today_not_analysis_date",
    "no_current_step_outside_real_today": true,
    "sections": [
      "cycle_movement",
      "selected_step",
      "ordered_path",
      "elements_and_features",
      "moon_challenge_result",
      "parent_at_analysis_date"
    ],
    "inspection_changes_date": false,
    "explicit_exploration_button": false,
    "saved_anchor_preserved": true
  }
