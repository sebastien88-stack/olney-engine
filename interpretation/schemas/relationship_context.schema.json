{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olney.local/schemas/relationship-context-1.2.0.json",
  "title": "Olney relationship context",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "relationship",
    "target_date",
    "subjects",
    "relationship_card",
    "relationship_life_path",
    "permanent_links",
    "natural_order_links",
    "natural_order_link_index",
    "annual_relationship_roles",
    "permanent_link_index",
    "current_clocks",
    "interpretation_order",
    "llm_policy",
    "personal_contexts",
    "knowledge_bundle"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "mode": {"const": "relationship"},
    "relationship": {"type": "object"},
    "target_date": {"type": "string", "format": "date"},
    "subjects": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "relationship_card": {
      "type": "object",
      "required": ["card_number", "card", "calculation"],
      "properties": {
        "card_number": {"type": "integer", "minimum": 1, "maximum": 52},
        "card": {"type": "string"},
        "calculation": {"type": "object"}
      }
    },
    "relationship_life_path": {
      "type": "object",
      "required": ["reference_card_number", "reference_card", "rows", "challenge", "result"],
      "properties": {
        "reference_card_number": {"type": "integer", "minimum": 1, "maximum": 52},
        "reference_card": {"type": "string"},
        "rows": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
        "challenge": {"type": "object"},
        "result": {"type": "object"}
      }
    },
    "permanent_links": {"type": "array", "items": {"type": "object"}},
    "natural_order_links": {"type": "array", "items": {"type": "object"}},
    "natural_order_link_index": {"type": "object"},
    "annual_relationship_roles": {"type": "array", "items": {"type": "object"}},
    "permanent_link_index": {"type": "object"},
    "current_clocks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "temporal_activations": {"type": "array", "items": {"type": "object"}},
    "common_events": {"type": "array", "items": {"type": "object"}},
    "interpretation_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "llm_policy": {"type": "object"},
    "personal_contexts": {"type": "array", "items": {"type": "object"}},
    "unavailable": {"type": "array", "items": {"type": "object"}},
    "knowledge_bundle": {"type": "object"}
  }
}
